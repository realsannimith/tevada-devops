# Copy this file to `.env` and fill in your key.

# Google Gemini API key for the Vercel AI SDK agent.
# Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional aliases for the same key:
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional: override the model (defaults to gemini-3.5-flash).
# AGENT_MODEL=gemini-3.5-flash

# Optional: override the runtime home directory (defaults to ~/.easyhost).
# Use `bun run electron:dev` to isolate dev data under ./.easyhost/electron-dev.
# EASYHOST_HOME=/path/to/custom/runtime

# Optional: client ID for one-click "Connect GitHub" in Settings (device
# flow — no client secret needed). RECOMMENDED: a GitHub App client id
# ("Iv…") — users then install the app and grant access to all or selected
# repositories, and can change that on GitHub any time. See
# docs/github-app-setup.md for the 5-minute registration walkthrough.
# A classic OAuth App client id also works (legacy: full repo scope).
# Without this, users can still connect by pasting a personal access token
# (repo scope) in Settings.
# GITHUB_CLIENT_ID=

# Optional but recommended with a GitHub App: the app's slug (the name in
# its public URL, github.com/apps/<slug>). Used for the "Grant repository
# access" button before the first installation exists.
# GITHUB_APP_SLUG=
